# Copy to .env.local. With these values the app runs on recorded fixtures
# and a development auth secret.

# Your Cardog API key (https://cardog.app/account/api). Server-side only; it
# never reaches the browser. Leave empty for fixture mode.
CARDOG_API_KEY=

# Signs sessions. This value is a DEVELOPMENT PLACEHOLDER so a fresh clone
# builds and runs; the app warns on every production start while it is set.
# Replace it before deploying: openssl rand -base64 32
BETTER_AUTH_SECRET=larkspur-dev-only-secret-replace-before-deploying

# Where the app is served. Needed when it is not http://localhost:3022.
BETTER_AUTH_URL=http://localhost:3022

# SQLite file and the folder walk-around photos are saved in. Created on first run.
DATABASE_PATH=data/larkspur.db
PHOTOS_DIR=data/photos

# Where the store is, for comparable listings nearby. Defaults to the
# store's own lot; radius in kilometres.
DEALER_LAT=43.5448
DEALER_LNG=-80.2482
DEALER_RADIUS_KM=250

# Seeded review logins are listed in the README.
